# GitHub
GITHUB_TOKEN=ghp_...                    # Personal Access Token with repo scope
GITHUB_WEBHOOK_SECRET=...               # Secret set when creating the webhook in GitHub

# Slack
SLACK_BOT_TOKEN=xoxb-...               # Bot token from your Slack app
SLACK_SIGNING_SECRET=...               # Signing secret from your Slack app settings
SLACK_CHANNEL_ID=C...                  # Channel ID where APEX posts (right-click channel → Copy ID)

# Database — any PostgreSQL connection string works (local, Neon, Supabase, Railway, etc.)
# Local:  postgresql://user:pass@localhost:5432/apex
# Neon:   postgresql://user:pass@host.neon.tech/apex?sslmode=require
DATABASE_URL=postgresql://user:pass@localhost:5432/apex

# Web UI — secret password to access the dashboard (leave empty to disable auth)
UI_SECRET=change-me
